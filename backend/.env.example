NODE_ENV=development
PORT=3001

# Required — PostgreSQL connection (no SQLite fallback)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gaming_db"

JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=7d

# Optional: required after first admin exists to allow more admin signups
ADMIN_SIGNUP_CODE=

# Sports odds proxy (server-side only)
ODDS_API_KEY=

# CORS (comma-separated). lucky-games-777.vercel.app is always allowed in code.
CORS_ORIGIN=http://localhost:3000,https://lucky-games-777.vercel.app

# Admin login (local and production seed): admin@games.com / 12345678
